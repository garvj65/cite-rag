        }
      ],
      "retrieved": [
        {
          "doc_id": "7576edb531d9848825814ee88e28b1795d3a84b435b4b797d3670eafdc4a89f1",
          "page": 11,
          "chunk_id": 15,
          "score": 0.01639344262295082,
          "vector_score": 0.7090658762462166,
