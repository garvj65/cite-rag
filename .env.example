# Local-only development database password; replace before public deployment.
POSTGRES_USER=citerag
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=citerag
DATABASE_URL=postgresql+psycopg://citerag:local-development-only@localhost:5432/citerag

# Explicit opt-in is required before contacting either real provider.
ENABLE_REAL_PROVIDERS=false
# gemini | openai | fake. 'fake' is an explicit keyless mechanics demo, not semantic search.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Explicit tested alternative: gemini-3.6-flash (3.8 returned 503 in the baseline).
LLM_PROVIDER=gemini
# Optional explicit scripted mode: set LLM_PROVIDER=fake. It defaults to a fixed refusal.
# FAKE_LLM_RESPONSE='{"answer":"","citations":[],"supported":false}'

# Optional paid original-stack configuration. Never used as a fallback.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=

CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=80
EMBEDDING_BATCH_SIZE=16
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_SECONDS=1
PROVIDER_MAX_BACKOFF_SECONDS=8
# HTTP response deadline; keep proxy timeout at least five seconds longer.
REQUEST_DEADLINE_SECONDS=90
PROXY_TIMEOUT_SECONDS=100
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=500

# Per-request strategy/k may override these defaults, within the configured bounds.
SEARCH_STRATEGY=vector
SEARCH_K=5
SEARCH_MAX_K=50
MAX_QUERY_CHARACTERS=2000
HYBRID_CANDIDATE_K=20
RRF_CONSTANT=60

# Provisional strategy-specific evidence gates. These are not calibrated probabilities.
ANSWER_MIN_VECTOR_SCORE=0.35
ANSWER_MIN_KEYWORD_SCORE=0.05
ANSWER_MIN_HYBRID_SCORE=0.02
ANSWER_CONTEXT_CHARACTERS=24000
ANSWER_MAX_CHARACTERS=12000
ANSWER_MAX_CITATIONS=8
ANSWER_MAX_QUOTE_CHARACTERS=2000
MODEL_MAX_OUTPUT_CHARACTERS=50000
CHAT_MAX_COMPLETION_TOKENS=4096
